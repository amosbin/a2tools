# /etc/a2tools/a2tools.conf
#
# Local a2tools overrides. This file is NOT touched by `apt upgrade` — dpkg's
# conffile mechanism preserves user edits across package upgrades. It is
# loaded AFTER /etc/a2tools/a2tools.conf.d/*.conf, so values you set here
# win over every drop-in (including the shipped 00-defaults.conf).
#
# Uncomment and edit any line below, or simply add new ones in the form
# `KEY="value"` (or `KEY=value` for unquoted paths).
#
# On the mail host: run a2wcrecalc-dms after new vhosts and renewals.
# DMS_ENABLED="true"
#
# Example: point a2wcrecalc-dms at a non-podmgr docker-mailserver stack.
# DMS_DIR="/srv/docker/docker-mailserver"
# DMS_CONFIG_DIR="/srv/docker/docker-mailserver/config"
# Stack owner (root inside a rootless container); empty for a rootful stack.
# For a podmgr stack: stat -c %U /srv/podmgr/compose/dms/compose.yaml
# DMS_OWNER="dms"
